        "modules/dnn/src/int8layers/*.cpp",
        "modules/dnn/src/layers/*.cpp",
        "modules/dnn/src/layers/cpu_kernels/*.cpp",
        "modules/dnn/src/onnx/*.cpp", // 目前只启用ONNX
        "modules/dnn/misc/onnx/*.cc",
    ],

    exclude_srcs: [
        "modules/dnn/src/net_openvino.cpp",
    ],

    host_ldlibs: [
        "-ldl",
        "-lm",
    ],

    shared_libs: [
        "liblog",
        "libopencv_core",
        "libopencv_imgproc",
        "libopencv-protobuf",
    ],
}

