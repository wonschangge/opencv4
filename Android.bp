        "modules/imgproc/src/resize.sse4_1.cpp",
        "modules/imgproc/src/sumpixels.avx512_skx.cpp",
    ],

    host_ldlibs: [
        "-ldl",
        "-lm",
    ],

    shared_libs: [
        "liblog",
        "libopencv_core"
    ],

