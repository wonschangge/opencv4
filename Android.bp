        "modules/objdetect/include/",
    ],

    srcs: ["samples/dnn/face_recognition_sface/main.cpp"],

    host_ldlibs: [
        "-ldl",
        "-lm",
        "-llog",
    ],

    shared_libs: [
        "libopencv_core",
        "libopencv_dnn",
        "libopencv_flann",
        "libopencv_imgproc",
        "libopencv_calib3d",
        "libopencv_features2d",
        "libopencv_objdetect",
    ],

    target: {
        android_arm64: {
            enabled: true,
        },
        android_x86_64: {
            enabled: true,
        },
    },
}
